{
  "family": "fragments-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::585707316183:role/LabRole",
  "taskRoleArn": "arn:aws:iam::585707316183:role/LabRole",
  "containerDefinitions": [
    {
      "name": "fragments",
      "image": "585707316183.dkr.ecr.us-east-2.amazonaws.com/fragments:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fragments-task",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": [
        {
          "name": "PORT",
          "value": "80"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-2"
        },
        {
          "name": "AWS_S3_BUCKET_NAME",
          "value": "bhaavanaroobhi-fragments"
        },
        {
          "name": "AWS_COGNITO_POOL_ID",
          "value": "us-east-2_HGgkgwLx3"
        },
        {
          "name": "AWS_COGNITO_CLIENT_ID",
          "value": "6bsjnjgdk4plpnuc16vho443a9"
        },
        {
          "name": "FRAGMENTS_LOG_LEVEL",
          "value": "info"
        },
        {
          "name": "API_URL",
          "value": "http://fragments-lb-1969722102.us-east-2.elb.amazonaws.com"
        }
      ]
    }
  ]
}
